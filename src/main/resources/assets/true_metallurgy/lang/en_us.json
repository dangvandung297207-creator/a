  "journal.true_metallurgy.title": "The Blacksmith's Journal",
  "journal.true_metallurgy.intro": "Ore becomes bloom, bloom becomes billet, billet becomes blade. Mind the heat, strike true, quench with intent. Every hammer strike matters.",
  "journal.true_metallurgy.best": "Finest work: %s (%s)",
  "journal.true_metallurgy.materials": "Known Materials",
  "journal.true_metallurgy.forging": "Forging",
  "journal.true_metallurgy.forging_text": "Strike inside the forging range. Aim for the marked zone, keep a steady rhythm, and reheat before the glow dies. Overworking and cold hits crack the steel.",
  "journal.true_metallurgy.quenching": "Quenching",
  "journal.true_metallurgy.quenching_text": "Water quenches fast and hard: sharper, but brittle. Oil quenches slow and kind: tougher and longer-lived. Quench only while the piece still glows.",
  "journal.true_metallurgy.grinding": "Grinding",
  "journal.true_metallurgy.grinding_text": "A keen 15-degree edge bites deep but chips. A sturdy 35-degree edge endures. 25 degrees is the honest compromise. Dress a worn wheel with cobblestone.",
